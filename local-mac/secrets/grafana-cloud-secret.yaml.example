apiVersion: v1
kind: Secret
metadata:
  name: grafana-cloud-credentials
  namespace: alloy
type: Opaque
stringData:
  # Ejemplo: Copia este archivo a 'grafana-cloud-secret.yaml' y completa tus datos
  # El archivo 'grafana-cloud-secret.yaml' está en .gitignore para que NUNCA suba a GitHub
  prometheus-url: "https://prometheus-prod-XX.grafana.net/api/prom/push"
  prometheus-user: "TU_PROMETHEUS_USER_ID"
  api-token: "TU_GRAFANA_CLOUD_TOKEN"

