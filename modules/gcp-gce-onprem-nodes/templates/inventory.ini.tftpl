# Generated by Terraform - idp-infra-core
# Kubespray / Ansible Inventory for Simulated On-Premises Bare-Metal Cluster

[all]
%{ for idx, cp in control_planes ~}
${cp.name} ansible_host=${try(cp.network_interface[0].access_config[0].nat_ip, cp.network_interface[0].network_ip)} ip=${cp.network_interface[0].network_ip} etcd_member_name=etcd${idx + 1} ansible_user=${ssh_user}
%{ endfor ~}
%{ for idx, wk in workers ~}
${wk.name} ansible_host=${try(wk.network_interface[0].access_config[0].nat_ip, wk.network_interface[0].network_ip)} ip=${wk.network_interface[0].network_ip} ansible_user=${ssh_user}
%{ endfor ~}

[kube_control_plane]
%{ for cp in control_planes ~}
${cp.name}
%{ endfor ~}

[etcd]
%{ for cp in control_planes ~}
${cp.name}
%{ endfor ~}

[kube_node]
%{ for wk in workers ~}
${wk.name}
%{ endfor ~}

[calico_rr]

[k8s_cluster:children]
kube_control_plane
kube_node
calico_rr

